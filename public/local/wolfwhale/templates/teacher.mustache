{{!
    @template local_wolfwhale/teacher

    Teacher home. Each tile is one word, one icon, and one real fact.

    The icons in this file are original WolfWhale artwork, GPL v3.
}}
<div class="ww-home">
    <button type="button" class="ww-speak ww-read" data-ww-speech="{{screenspeech}}" hidden>
        <svg class="ww-speak-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <path d="M8 24h12l14-12v40L20 40H8z" fill="currentColor"/>
            <path d="M42 22a14 14 0 0 1 0 20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            <path d="M48 14a24 24 0 0 1 0 36" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
        </svg>
        <span>{{read}}</span>
    </button>
    <div class="ww-home-tiles">
        {{#tiles}}
        <article class="ww-tile ww-tile-{{id}}{{#empty}} is-empty{{/empty}}">
            <a class="ww-tile-link" href="{{url}}">
                <span class="ww-tile-icon" aria-hidden="true">
                    {{#ispost}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <path d="M14 8h26l12 12v36H14z" fill="currentColor"/>
                        <path d="M40 8v12h12" fill="#fff"/>
                        <path d="M24 44l16-16 4 4-16 16h-4z" fill="#fff"/>
                    </svg>
                    {{/ispost}}
                    {{#ismarking}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <rect x="8" y="8" width="48" height="48" rx="8" fill="currentColor"/>
                        <path d="M18 34l10 10 18-22" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{/ismarking}}
                    {{#isattendance}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <circle cx="22" cy="16" r="8" fill="currentColor"/>
                        <circle cx="44" cy="20" r="7" fill="currentColor" opacity=".75"/>
                        <path d="M6 52c2-12 8-16 16-16s14 4 16 16" fill="currentColor"/>
                        <path d="M32 54c1-9 6-12 12-12s11 3 13 12" fill="currentColor" opacity=".75"/>
                    </svg>
                    {{/isattendance}}
                    {{#ismessages}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <path d="M10 12h40a6 6 0 0 1 6 6v18a6 6 0 0 1-6 6H28L16 54V42h-6a6 6 0 0 1-6-6V18a6 6 0 0 1 6-6z" fill="currentColor"/>
                    </svg>
                    {{/ismessages}}
                    {{#isstuck}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <circle cx="24" cy="16" r="8" fill="currentColor"/>
                        <path d="M8 54c2-14 8-18 16-18s14 4 16 18" fill="currentColor"/>
                        <path d="M50 12v20" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
                        <circle cx="50" cy="46" r="4" fill="currentColor"/>
                    </svg>
                    {{/isstuck}}
                    {{#ismarks}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <rect x="8" y="10" width="48" height="44" rx="6" fill="currentColor"/>
                        <path d="M8 24h48M8 38h48M26 24v30M42 24v30" fill="none" stroke="#fff" stroke-width="3"/>
                    </svg>
                    {{/ismarks}}
                    {{#isreport}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <path d="M16 6h24l12 12v40H16z" fill="currentColor"/>
                        <path d="M24 30h20M24 40h20M24 50h12" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
                    </svg>
                    {{/isreport}}
                    {{#ispoints}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <path d="M32 6l7 16 17 2-13 11 4 17-15-9-15 9 4-17L8 24l17-2z" fill="currentColor"/>
                    </svg>
                    {{/ispoints}}
                    {{#isgoal}}
                    <svg viewBox="0 0 64 64" focusable="false">
                        <path d="M14 8h6v48h-6z" fill="currentColor"/>
                        <path d="M20 10h30l-8 12 8 12H20z" fill="currentColor"/>
                    </svg>
                    {{/isgoal}}
                </span>
                <span class="ww-tile-word">{{word}}</span>
                <span class="ww-tile-fact">{{fact}}</span>
            </a>
            <button type="button" class="ww-speak" data-ww-speech="{{speech}}" aria-label="{{speech}}" hidden>
                <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                    <path d="M8 24h12l14-12v40L20 40H8z" fill="currentColor"/>
                    <path d="M42 22a14 14 0 0 1 0 20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                    <path d="M48 14a24 24 0 0 1 0 36" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                </svg>
            </button>
        </article>
        {{/tiles}}
    </div>
    <div class="ww-goals">
        {{> local_wwpoints/goals }}
    </div>
</div>
{{#js}}
(function() {
    if (!window.speechSynthesis || typeof window.SpeechSynthesisUtterance !== 'function') {
        return;
    }
    var buttons = document.querySelectorAll('.ww-home .ww-speak');
    for (var i = 0; i < buttons.length; i++) {
        (function(button) {
            button.hidden = false;
            button.addEventListener('click', function(event) {
                event.preventDefault();
                event.stopPropagation();
                var text = button.getAttribute('data-ww-speech') || '';
                if (!text) {
                    return;
                }
                window.speechSynthesis.cancel();
                var utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = document.documentElement.lang || 'en';
                window.speechSynthesis.speak(utterance);
            });
        })(buttons[i]);
    }
})();
{{/js}}
