{{!
    @template local_wolfwhale/link

    Link a parent account to a child.
}}
<div class="ww-home ww-link">
    {{#error}}
    <p class="ww-row-word ww-row">{{error}}</p>
    {{/error}}
    {{#haschildren}}
    <form method="post" action="">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <label class="ww-field">
            <span class="ww-field-word">{{parent}}</span>
            <input type="text" name="parentusername" autocomplete="off" required>
        </label>
        <label class="ww-field">
            <span class="ww-field-word">{{child}}</span>
            <select name="childid" required>
                {{#children}}
                <option value="{{id}}">{{name}}</option>
                {{/children}}
            </select>
        </label>
        <button type="submit" class="ww-submit" name="link" value="1">{{link}}</button>
    </form>
    {{/haschildren}}
    {{^haschildren}}
    <p class="ww-row-word ww-row ww-row-empty">{{none}}</p>
    {{/haschildren}}
    <div class="ww-list">
        {{#links}}
        <form method="post" action="" class="ww-link-row">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="parentid" value="{{parentid}}">
            <input type="hidden" name="childid" value="{{childid}}">
            <span class="ww-row-word">{{childname}}</span>
            <span class="ww-row-fact">{{parentname}}</span>
            <button type="submit" class="ww-submit ww-unlink" name="unlink" value="1">{{unlink}}</button>
        </form>
        {{/links}}
    </div>
</div>
