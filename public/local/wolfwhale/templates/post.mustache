{{!
    @template local_wolfwhale/post

    One course, then Lesson, File, and Assignment. Each opens the real add screen.
}}
<div class="ww-home">
    {{#empty}}
    <p class="ww-row-word ww-row ww-row-empty">{{none}}</p>
    {{/empty}}
    {{#courses}}
    <section class="ww-course">
        <h2 class="ww-course-name">{{name}}</h2>
        <div class="ww-actions">
            {{#actions}}
            <a class="ww-action" href="{{url}}">{{word}}</a>
            {{/actions}}
        </div>
    </section>
    {{/courses}}
</div>
