{{!
    @template local_wwadmin/page

    A list or a form on the admin home.
}}
<div class="ww-home">
    {{#back}}
    <a class="ww-action ww-back" href="{{back}}">{{backword}}</a>
    {{/back}}
    {{#word}}<p class="ww-course-name">{{word}}</p>{{/word}}
    <div class="ww-list">
        {{#empty}}
        <p class="ww-row-word ww-row">{{none}}</p>
        {{/empty}}
        {{#rows}}
        {{#url}}
        <a class="ww-row" href="{{url}}">
            <span class="ww-row-word">{{word}}</span>
            {{#fact}}<span class="ww-row-fact">{{fact}}</span>{{/fact}}
        </a>
        {{/url}}
        {{^url}}
        <div class="ww-row">
            <span class="ww-row-word">{{word}}</span>
            {{#fact}}<span class="ww-row-fact">{{fact}}</span>{{/fact}}
        </div>
        {{/url}}
        {{#deleteurl}}
        <a class="ww-action" href="{{deleteurl}}">{{delete}}</a>
        {{/deleteurl}}
        {{/rows}}
        {{#actions}}
        {{#post}}
        <form method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="category" value="{{category}}">
            <button type="submit" class="ww-action">
                <span class="ww-row-word">{{word}}</span>
                {{#fact}}<span class="ww-row-fact">{{fact}}</span>{{/fact}}
            </button>
        </form>
        {{/post}}
        {{^post}}
        <a class="ww-action" href="{{url}}">
            <span class="ww-row-word">{{word}}</span>
            {{#fact}}<span class="ww-row-fact">{{fact}}</span>{{/fact}}
        </a>
        {{/post}}
        {{/actions}}
    </div>
    {{#form}}
    {{> local_wwadmin/form }}
    {{/form}}
    {{#forms}}
    {{> local_wwadmin/form }}
    {{/forms}}
</div>
