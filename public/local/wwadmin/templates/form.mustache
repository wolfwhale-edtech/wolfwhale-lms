{{!
    @template local_wwadmin/form

    One form. Labels are the field names.
}}
<form method="post" action="{{action}}" class="ww-form"{{#file}} enctype="multipart/form-data"{{/file}}>
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    {{#hidden}}
    <input type="hidden" name="{{name}}" value="{{value}}">
    {{/hidden}}
    {{#fields}}
    <label class="ww-field">
        <span class="ww-row-word">{{label}}</span>
        {{#text}}<input type="text" name="{{name}}" value="{{value}}" required>{{/text}}
        {{#password}}<input type="password" name="{{name}}" autocomplete="new-password" required>{{/password}}
        {{#date}}<input type="date" name="{{name}}" required>{{/date}}
        {{#file}}<input type="file" name="{{name}}" accept=".csv,text/csv" required>{{/file}}
        {{#select}}
        <select name="{{name}}" required>
            {{#options}}<option value="{{value}}">{{label}}</option>{{/options}}
        </select>
        {{/select}}
    </label>
    {{/fields}}
    <button type="submit" class="ww-action">{{submit}}</button>
</form>
