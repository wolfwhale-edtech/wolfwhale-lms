{{!
    @template local_wwreports/card

    One student's term report card.
}}
<div class="ww-home ww-card">
    <div class="ww-terms ww-nav">
        {{#people}}
        <a class="ww-child{{#current}} is-current{{/current}}" href="{{url}}">{{name}}</a>
        {{/people}}
        {{#terms}}
        <a class="ww-child{{#current}} is-current{{/current}}" href="{{url}}">{{name}}</a>
        {{/terms}}
        {{#htmlurl}}
        <a class="ww-print" href="{{htmlurl}}">{{html}}</a>
        <a class="ww-print" href="{{csvurl}}">{{csv}}</a>
        <button type="button" class="ww-print ww-print-button">{{print}}</button>
        {{/htmlurl}}
        <button type="button" class="ww-speak ww-read" data-ww-speech="{{screenspeech}}" hidden>
            <svg class="ww-speak-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <path d="M8 24h12l14-12v40L20 40H8z" fill="currentColor"/>
                <path d="M42 22a14 14 0 0 1 0 20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                <path d="M48 14a24 24 0 0 1 0 36" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            </svg>
            <span>{{read}}</span>
        </button>
    </div>
    {{#studentname}}
    <h1 class="ww-report-name">{{studentname}}</h1>
    <p class="ww-report-term">{{termname}}</p>
    {{/studentname}}
    <div class="ww-list">
        {{#empty}}
        <p class="ww-row-word ww-row ww-row-empty">{{none}}</p>
        {{/empty}}
        {{#courses}}
        <article class="ww-row ww-report-row">
            <h2 class="ww-row-word">{{name}}</h2>
            <p class="ww-row-fact">{{mark}}</p>
            {{#items}}
            <p class="ww-item"><span class="ww-row-word">{{name}}</span> <span class="ww-row-fact">{{grade}}</span></p>
            {{/items}}
            <p class="ww-row-fact">{{attendance}}</p>
            {{#comments}}
            <p class="ww-row-word">{{author}}</p>
            <p class="ww-row-fact">{{text}}</p>
            {{/comments}}
            {{#cancomment}}
            <form class="ww-comment-form" method="post" action="{{formurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="student" value="{{studentid}}">
                <input type="hidden" name="term" value="{{termid}}">
                <input type="hidden" name="course" value="{{courseid}}">
                <textarea name="comment">{{draft}}</textarea>
                <button type="submit" class="ww-print">{{save}}</button>
            </form>
            {{/cancomment}}
        </article>
        {{/courses}}
        {{^picker}}
        <article class="ww-row ww-report-row">
            {{#badges}}
            <p class="ww-row-word">{{name}}</p>
            {{/badges}}
            <p class="ww-row-word">{{pointsword}}</p>
            <p class="ww-row-fact">{{points}}</p>
            <p class="ww-row-word">{{levelword}}</p>
            <p class="ww-row-fact">{{level}}</p>
        </article>
        {{/picker}}
    </div>
</div>
{{#js}}
(function() {
    var root = document.querySelector('.ww-card');
    if (!root) {
        return;
    }
    var printbutton = root.querySelector('.ww-print-button');
    if (printbutton) {
        printbutton.addEventListener('click', function() {
            window.print();
        });
    }
    if (!window.speechSynthesis || typeof window.SpeechSynthesisUtterance !== 'function') {
        return;
    }
    var buttons = root.querySelectorAll('.ww-speak');
    for (var i = 0; i < buttons.length; i++) {
        (function(button) {
            button.hidden = false;
            button.addEventListener('click', function(event) {
                event.preventDefault();
                var text = button.getAttribute('data-ww-speech') || '';
                if (!text) {
                    return;
                }
                window.speechSynthesis.cancel();
                window.speechSynthesis.speak(new SpeechSynthesisUtterance(text));
            });
        })(buttons[i]);
    }
})();
{{/js}}
