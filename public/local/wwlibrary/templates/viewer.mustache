{{!
    @template local_wwlibrary/viewer

    One map, world, or model.
}}
<div class="ww-library-view">
    {{#showtitle}}<h1 class="ww-library-name">{{name}}</h1>{{/showtitle}}
    {{#isurl}}
    <iframe class="ww-library-frame" src="{{frameurl}}" title="{{name}}" sandbox="{{sandbox}}" referrerpolicy="no-referrer"></iframe>
    {{/isurl}}
    {{#ispackage}}
    <div class="ww-library-package" data-ww-package="{{manifest}}">
        <iframe class="ww-library-frame" title="{{name}}" sandbox="allow-scripts allow-pointer-lock allow-downloads" referrerpolicy="no-referrer"></iframe>
    </div>
    <script src="{{viewerscript}}"></script>
    {{/ispackage}}
    {{#ismodel}}
    <script type="module" src="{{modelscript}}"></script>
    <model-viewer class="ww-library-model" src="{{modelurl}}" alt="{{name}}" camera-controls auto-rotate environment-image="neutral"></model-viewer>
    {{/ismodel}}
    {{#isworld}}
    <div class="ww-actions">
        {{#launchurl}}
        <a class="ww-action" href="{{launchurl}}"{{#externallaunch}} target="_blank" rel="noopener noreferrer"{{/externallaunch}}>{{launch}}</a>
        {{/launchurl}}
        {{#downloadurl}}
        <a class="ww-action" href="{{downloadurl}}">{{download}}</a>
        {{/downloadurl}}
    </div>
    {{/isworld}}
    {{#isnone}}
    <p class="ww-row-word">{{none}}</p>
    {{/isnone}}
</div>
