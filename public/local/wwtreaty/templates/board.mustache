{{!
    @template local_wwtreaty/board

    Tiles. Each tile is a word and a fact.
}}
<div class="ww-home">
    <div class="ww-home-tiles">
        {{#tiles}}
        <article class="ww-tile{{#status}} ww-tile-{{status}}{{/status}}{{#empty}} is-empty{{/empty}}{{#on}} is-on{{/on}}">
            {{#post}}
            <form method="post" action="{{action}}" class="ww-tile-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#hidden}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hidden}}
                <button type="submit" class="ww-tile-link">
                    <span class="ww-tile-word">{{word}}</span>
                    {{#fact}}<span class="ww-tile-fact">{{fact}}</span>{{/fact}}
                    {{#bar}}<span class="ww-treaty-bar" style="--ww-treaty: {{percent}}"><span></span></span>{{/bar}}
                </button>
            </form>
            {{/post}}
            {{^post}}
            {{#url}}
            <a class="ww-tile-link" href="{{url}}">
                <span class="ww-tile-word">{{word}}</span>
                {{#fact}}<span class="ww-tile-fact">{{fact}}</span>{{/fact}}
                {{#bar}}<span class="ww-treaty-bar" style="--ww-treaty: {{percent}}"><span></span></span>{{/bar}}
            </a>
            {{/url}}
            {{^url}}
            <div class="ww-tile-link">
                <span class="ww-tile-word">{{word}}</span>
                {{#fact}}<span class="ww-tile-fact">{{fact}}</span>{{/fact}}
            </div>
            {{/url}}
            {{/post}}
        </article>
        {{/tiles}}
    </div>
    {{#form}}
    {{> local_wwtreaty/form }}
    {{/form}}
</div>
