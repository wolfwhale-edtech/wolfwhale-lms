{{!
    @template local_wwattendance/take

    One course, one day. Each person has Present, Absent, and Late.
}}
<div class="ww-attend">
    <h1 class="ww-attend-course">{{course}}</h1>
    {{#empty}}
    <p class="ww-attend-none">{{none}}</p>
    {{/empty}}
    {{^empty}}
    <form method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="courseid" value="{{courseid}}">
        {{#students}}
        <fieldset class="ww-person">
            <legend class="ww-person-name"><span class="ww-avatar">{{{avatar}}}</span>{{name}}</legend>
            <div class="ww-choices">
                <label class="ww-choice ww-present{{#ispresent}} is-on{{/ispresent}}">
                    <input type="radio" name="status[{{id}}]" value="present"{{#ispresent}} checked{{/ispresent}}>
                    <span>{{present}}</span>
                </label>
                <label class="ww-choice ww-absent{{#isabsent}} is-on{{/isabsent}}">
                    <input type="radio" name="status[{{id}}]" value="absent"{{#isabsent}} checked{{/isabsent}}>
                    <span>{{absent}}</span>
                </label>
                <label class="ww-choice ww-late{{#islate}} is-on{{/islate}}">
                    <input type="radio" name="status[{{id}}]" value="late"{{#islate}} checked{{/islate}}>
                    <span>{{late}}</span>
                </label>
            </div>
        </fieldset>
        {{/students}}
        {{#hassave}}
        <button type="submit" class="ww-save">{{save}}</button>
        {{/hassave}}
    </form>
    {{/empty}}
</div>
