{{!
    @template local_wwupdates/toggle

    One switch: an icon, a word, and On or Off.
}}
<label class="ww-toggle{{#on}} is-on{{/on}}{{^on}} is-off{{/on}}">
    <input type="checkbox" name="{{key}}" value="1" {{#on}}checked{{/on}}>
    <span class="ww-toggle-icon" aria-hidden="true">
        {{#isapp}}
        <svg viewBox="0 0 64 64" focusable="false"><path d="M14 10h28a6 6 0 0 1 6 6v24a6 6 0 0 1-6 6H28l-10 10V46h-4a6 6 0 0 1-6-6V16a6 6 0 0 1 6-6z" fill="currentColor"/></svg>
        {{/isapp}}
        {{#isemail}}
        <svg viewBox="0 0 64 64" focusable="false"><path d="M8 16h48v32H8z" fill="currentColor"/><path d="M10 18l22 16L54 18" fill="none" stroke="#fff" stroke-width="4"/></svg>
        {{/isemail}}
        {{#istext}}
        <svg viewBox="0 0 64 64" focusable="false"><rect x="18" y="6" width="28" height="52" rx="6" fill="currentColor"/><circle cx="32" cy="48" r="3" fill="#fff"/></svg>
        {{/istext}}
        {{#ismark}}
        <svg viewBox="0 0 64 64" focusable="false"><rect x="8" y="36" width="10" height="20" rx="2" fill="currentColor"/><rect x="27" y="22" width="10" height="34" rx="2" fill="currentColor"/><rect x="46" y="10" width="10" height="46" rx="2" fill="currentColor"/></svg>
        {{/ismark}}
        {{#isabsent}}
        <svg viewBox="0 0 64 64" focusable="false"><circle cx="24" cy="18" r="8" fill="currentColor"/><path d="M8 52c2-12 8-18 16-18s14 6 16 18" fill="currentColor"/><path d="M42 28l14 14M56 28L42 42" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
        {{/isabsent}}
        {{#isdue}}
        <svg viewBox="0 0 64 64" focusable="false"><circle cx="32" cy="32" r="22" fill="none" stroke="currentColor" stroke-width="4"/><path d="M32 16v18l12 7" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
        {{/isdue}}
        {{#isbadge}}
        <svg viewBox="0 0 64 64" focusable="false"><path d="M20 6h8l2 18h-12zM36 6h8l2 18H34z" fill="currentColor"/><circle cx="32" cy="40" r="16" fill="currentColor"/></svg>
        {{/isbadge}}
        {{#ismessage}}
        <svg viewBox="0 0 64 64" focusable="false"><path d="M10 12h40a6 6 0 0 1 6 6v18a6 6 0 0 1-6 6H28L16 54V42h-6a6 6 0 0 1-6-6V18a6 6 0 0 1 6-6z" fill="currentColor"/></svg>
        {{/ismessage}}
        {{#isweekly}}
        <svg viewBox="0 0 64 64" focusable="false"><rect x="8" y="12" width="48" height="44" rx="6" fill="currentColor"/><path d="M8 24h48" stroke="#fff" stroke-width="4"/><path d="M20 8v10M44 8v10" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
        {{/isweekly}}
    </span>
    <span class="ww-toggle-word">{{word}}</span>
    <span class="ww-toggle-state">{{state}}</span>
</label>
