{{!
    @template local_wwupdates/schedule

    Day and hour for each school.
}}
<form class="ww-updates" method="post">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    {{#schools}}
    <section class="ww-school">
        <h2>{{name}}</h2>
        <label class="ww-choice">
            <span>{{day}}</span>
            <select name="weekday[{{id}}]">
                {{#days}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/days}}
            </select>
        </label>
        <label class="ww-choice">
            <span>{{time}}</span>
            <select name="hour[{{id}}]">
                {{#hours}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/hours}}
            </select>
        </label>
    </section>
    {{/schools}}
    <button class="ww-save" type="submit">{{save}}</button>
</form>
