{{!
    @template local_wwupdates/preferences

    Parent switches. Each control is an icon and a word.

    The icons in this file are original WolfWhale artwork, GPL v3.
}}
<form class="ww-updates" method="post">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <div class="ww-toggles">
        {{#channels}}
        {{> local_wwupdates/toggle }}
        {{/channels}}
    </div>
    <div class="ww-toggles">
        {{#types}}
        {{> local_wwupdates/toggle }}
        {{/types}}
    </div>
    <label class="ww-phone">
        <span>{{phoneword}}</span>
        <input type="tel" name="phone" value="{{phone}}" autocomplete="tel" inputmode="tel">
    </label>
    <button class="ww-save" type="submit">{{save}}</button>
</form>
{{#js}}
(function() {
    var inputs = document.querySelectorAll('.ww-updates .ww-toggle input');
    for (var i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener('change', function() {
            this.form.submit();
        });
    }
})();
{{/js}}
