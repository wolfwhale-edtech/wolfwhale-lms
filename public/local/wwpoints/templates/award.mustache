{{!
    @template local_wwpoints/award

    Give or take points. Each person is a name, their points, and two actions.
}}
<div class="ww-home">
    <h1 class="ww-page-title">{{title}}</h1>
    {{#rows}}
    <a class="ww-row" href="{{url}}"><span class="ww-row-word">{{word}}</span></a>
    {{/rows}}
    {{#course}}
    {{#empty}}
    <p class="ww-row-word ww-row">{{none}}</p>
    {{/empty}}
    {{#students}}
    <form method="post" action="{{action}}" class="ww-award">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="student" value="{{id}}">
        <div class="ww-award-person">
            <span class="ww-avatar">{{{avatar}}}</span>
            <span class="ww-award-name">{{name}}</span>
            <span class="ww-award-total">{{total}}</span>
        </div>
        <label class="ww-field">
            <span>{{pointsword}}</span>
            <input type="number" name="amount" min="1" value="1" required>
        </label>
        <label class="ww-field">
            <span>{{reasonword}}</span>
            <input type="text" name="reason" maxlength="255" required>
        </label>
        <div class="ww-award-actions">
            <button type="submit" name="action" value="give" class="ww-save">{{give}}</button>
            <button type="submit" name="action" value="take" class="ww-save ww-take">{{take}}</button>
        </div>
    </form>
    {{/students}}
    {{/course}}
</div>
