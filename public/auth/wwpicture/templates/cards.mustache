{{!
    @template auth_wwpicture/cards

    Picture cards for printing.

    Example context (json):
    {}
}}
<button class="btn btn-primary ww-noprint" type="button" onclick="window.print()">{{#str}}cards, auth_wwpicture{{/str}}</button>
{{#cards}}
    <section class="ww-card">
        {{{face}}}
        <div>
            <h2>{{name}}</h2>
            <div class="ww-slots">
                {{#pics}}{{{svg}}}{{/pics}}
            </div>
        </div>
    </section>
{{/cards}}
