{{!
    @template auth_wwpicture/schools

    Picture sign-in and email domains for each school.

    Example context (json):
    {}
}}
<form class="ww-schools" method="post" action="{{url}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    {{#schools}}
        <fieldset>
            <legend>{{name}}</legend>
            <label>
                <input type="checkbox" name="enabled{{id}}" value="1" {{#enabled}}checked{{/enabled}}>
                {{#str}}picture, auth_wwpicture{{/str}}
            </label>
            <label>
                {{#str}}domains, auth_wwpicture{{/str}}
                <input type="text" name="domains{{id}}" value="{{domains}}">
            </label>
        </fieldset>
    {{/schools}}
    <button class="btn btn-primary" type="submit">{{#str}}save{{/str}}</button>
</form>
