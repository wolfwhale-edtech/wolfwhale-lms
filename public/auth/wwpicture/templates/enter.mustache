{{!
    @template auth_wwpicture/enter

    Three picture taps.

    Example context (json):
    {}
}}
<div class="ww-enter">
    <h1 class="ww-who">{{{face}}}<span>{{name}}</span></h1>
    <form method="post" action="{{url}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="ww-slots">
            {{#slots}}{{{svg}}}{{/slots}}
        </div>
        {{#locked}}
            <p class="ww-locked">{{#str}}locked, auth_wwpicture{{/str}}</p>
        {{/locked}}
        <div class="ww-pics">
            {{#pics}}
                <button class="ww-pic" type="submit" name="pic" value="{{key}}" aria-label="{{word}}" {{#locked}}disabled{{/locked}}>
                    {{{svg}}}
                </button>
            {{/pics}}
        </div>
        {{#haspicks}}
            <button class="ww-again" type="submit" name="again" value="1">{{#str}}again, auth_wwpicture{{/str}}</button>
        {{/haspicks}}
    </form>
</div>
