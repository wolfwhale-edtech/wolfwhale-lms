{{!
    @template auth_wwpicture/teacher

    Class link and resets.

    Example context (json):
    {}
}}
<div class="ww-teacher">
    <h1>{{coursename}}</h1>
    <div class="ww-qr">{{{qr}}}</div>
    <p><a href="{{url}}">{{url}}</a></p>
    <form method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <button class="btn btn-primary" type="submit" name="all" value="1">{{#str}}cards, auth_wwpicture{{/str}}</button>
        <ul class="ww-roster">
            {{#students}}
                <li>
                    {{{face}}}
                    <span>{{name}}</span>
                    <button class="btn btn-outline-secondary" type="submit" name="reset" value="{{id}}">{{#str}}reset, auth_wwpicture{{/str}}</button>
                </li>
            {{/students}}
        </ul>
    </form>
</div>
