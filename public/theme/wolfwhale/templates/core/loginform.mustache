{{!
    @template core/loginform

    WolfWhale sign-in: email, password, Google, Microsoft, Picture.

    Example context (json):
    {
        "loginurl": "https://example.com/login/index.php",
        "logintoken": "tok",
        "pictureurl": "https://example.com/auth/wwpicture/login.php"
    }
}}
<div class="loginform">
    <h1 class="ww-wordmark d-lg-none mb-4">WOLFWHALE</h1>
    {{#maintenance}}
        <div class="alert alert-danger login-maintenance">{{{maintenance}}}</div>
    {{/maintenance}}
    {{#error}}
        <div class="alert alert-danger" id="loginerrormessage" role="alert">{{error}}</div>
    {{/error}}
    <form class="login-form" action="{{loginurl}}" method="post" id="login">
        <input type="hidden" name="logintoken" value="{{logintoken}}">
        <div class="mb-3">
            <label for="username" class="form-label">{{#str}}email, auth_wwpicture{{/str}}</label>
            <input type="text" name="username" id="username" class="form-control" value="{{username}}" autocomplete="username">
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">{{#str}}password{{/str}}</label>
            <input type="password" name="password" id="password" class="form-control" autocomplete="current-password">
        </div>
        {{#recaptcha}}
            <div class="mb-3">{{{recaptcha}}}</div>
        {{/recaptcha}}
        <button class="btn btn-primary ww-signin" type="submit" id="loginbtn">{{#str}}login{{/str}}</button>
    </form>
    {{#google}}
        <a class="btn ww-oauth" href="{{url}}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" fill="none" stroke="#2f5d8a" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="#2f5d8a"/></svg>
            {{#str}}google, auth_wwpicture{{/str}}
        </a>
    {{/google}}
    {{#microsoft}}
        <a class="btn ww-oauth" href="{{url}}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="8" height="8" fill="#2f5d8a"/><rect x="13" y="3" width="8" height="8" fill="#2f5d8a"/><rect x="3" y="13" width="8" height="8" fill="#2f5d8a"/><rect x="13" y="13" width="8" height="8" fill="#2f5d8a"/></svg>
            {{#str}}microsoft, auth_wwpicture{{/str}}
        </a>
    {{/microsoft}}
    <a class="btn ww-oauth" href="{{pictureurl}}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="#8fd4f5"/><circle cx="9" cy="11" r="1.2" fill="#16324a"/><circle cx="15" cy="11" r="1.2" fill="#16324a"/><path d="M9 15c1 1.4 5 1.4 6 0" fill="none" stroke="#16324a" stroke-width="1.2" stroke-linecap="round"/></svg>
        {{#str}}picture, auth_wwpicture{{/str}}
    </a>
</div>
{{#js}}
require(['core_form/submit'], function(Submit) {
    Submit.init("loginbtn");
});
{{/js}}
